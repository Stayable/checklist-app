# RISE8 Operations Platform — environment variables
#
# Copy this file to `.env.local` for local dev. Never commit `.env.local`.
# Production / staging / preview values live in Vercel project envs.
# Source of truth for what each var does: docs/ARCHITECTURE.md §8.3.

# ── Database (Neon Postgres) ──────────────────────────────────────────────────
# Pooled connection string from Neon. Use the "pooled" branch URL for runtime.
# For Prisma migrate, use the unpooled `DIRECT_URL` (add when running migrations).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Auth.js v5 ────────────────────────────────────────────────────────────────
# 32+ random bytes. Generate with: `openssl rand -base64 32`
AUTH_SECRET=""
# Public canonical URL for this environment (no trailing slash).
# Dev: http://localhost:3000  ·  Preview: Vercel preview URL  ·  Prod: https://ops.stayable.com
AUTH_URL="http://localhost:3000"

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=""
# Verified sender. Must match a domain configured in Resend.
RESEND_FROM_EMAIL="RISE8 Ops <no-reply@stayable.com>"

# ── Photo + PDF storage (Cloudflare R2) ───────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="rise8-ops-staging"
# Public URL prefix for served R2 objects (custom domain or r2.dev URL).
R2_PUBLIC_URL=""

# ── Background jobs (Inngest) ─────────────────────────────────────────────────
INNGEST_SIGNING_KEY=""
INNGEST_EVENT_KEY=""

# ── Error tracking (Sentry) ───────────────────────────────────────────────────
SENTRY_DSN=""

# ── Public app URL (exposed to the client) ────────────────────────────────────
# Same value as AUTH_URL but accessible in browser bundles.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
