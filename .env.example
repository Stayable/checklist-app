# RISE8 Operations Platform — environment variables
#
# Copy this file to `.env.local` for local dev. Never commit `.env.local`.
# Production / staging / preview values live in Vercel project envs.
# Source of truth for what each var does: docs/ARCHITECTURE.md §8.3.

# ── Database (Neon Postgres) ──────────────────────────────────────────────────
# Pooled URL (has `-pooler` in host) for runtime queries.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/DB?sslmode=require"
# Direct (unpooled) URL for Prisma migrate at deploy time.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/DB?sslmode=require"

# ── Auth.js v5 ────────────────────────────────────────────────────────────────
# 32+ random bytes. Generate with: `openssl rand -base64 32`
AUTH_SECRET=""
# Public canonical URL for this environment (no trailing slash).
# Dev: http://localhost:3000  ·  Preview: Vercel preview URL  ·  Prod: https://ops.stayable.com
AUTH_URL="http://localhost:3000"

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=""
# Verified sender. Must match a domain configured in Resend.
RESEND_FROM_EMAIL="RISE8 Ops <no-reply@stayable.com>"

# ── Photo + PDF storage (Cloudflare R2) ───────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="rise8-ops-staging"
# R2_PUBLIC_URL intentionally absent — bucket is PRIVATE (ARCH §9.2); all
# reads/writes go through presigned URLs minted in lib/r2.ts.

# ── Background jobs (Inngest) ─────────────────────────────────────────────────
INNGEST_SIGNING_KEY=""
INNGEST_EVENT_KEY=""

# ── Cron auth (Vercel Cron) ───────────────────────────────────────────────────
# Vercel injects `Authorization: Bearer ${CRON_SECRET}` on scheduled invocations
# of /api/cron/*. Set in Production so the route rejects unauthorized callers.
# Unset locally = route open for manual testing.
CRON_SECRET=""

# ── Network monitoring webhooks (NETWORK epic) ────────────────────────────────
# HMAC-SHA256 shared secrets configured in the UniFi controller / Aruba
# Instant On portal webhook settings. The app verifies each delivery's
# `x-webhook-signature: sha256=<hex>` header against the raw request body
# (lib/network/hmac.ts). Unset locally = signature check skipped for
# dev/fixture testing; unset in production = requests rejected (fail-closed).
UNIFI_WEBHOOK_SECRET=""
ARUBA_WEBHOOK_SECRET=""

# ── Spotipo guest WiFi (NETWORK epic, T9) ────────────────────────────────────
# Resolution is ENV-FIRST (lib/network/spotipo-config.ts). Putting the key here
# rather than in Property.spotipoApiKey keeps it out of the database — and so out
# of backups, query logs and every Property read.
#
# API KEY — set ONE of these two forms:
#   SPOTIPO_API_KEY            one key covering the whole Spotipo account
#   SPOTIPO_API_KEY_<CODE>     per-site key; overrides the account key
SPOTIPO_API_KEY=""
#
# SITE ID — one per property, by 2-letter short code. Site ids are not secrets,
# but they live here so the whole config sits in one place.
#   JN Jacksonville North · JW Jacksonville West · KE Kissimmee East
#   KW Kissimmee West · LL Lakeland · OR Orlando OBT · SA St. Augustine
#   DP Davenport
SPOTIPO_SITE_ID_JN=""
SPOTIPO_SITE_ID_JW=""
SPOTIPO_SITE_ID_KE=""
SPOTIPO_SITE_ID_KW=""
SPOTIPO_SITE_ID_LL=""
SPOTIPO_SITE_ID_OR=""
SPOTIPO_SITE_ID_SA=""
SPOTIPO_SITE_ID_DP=""
#
# Only set the properties that actually have a Spotipo site. A site id without a
# key (or the reverse) counts as UNCONFIGURED, not half-configured — otherwise
# the page would claim to be wired up and then render permanently blank.
#
# Verified live 2026-07-29 against all 8 sites: guest counts come back real, from
# `metadata.total_count` on GET /ext/{siteId}/api/v1/guest/. What this API does
# NOT provide, confirmed by probing: revenue (no field, and /stats/ /report/
# /analytics/ /transaction/ /payment/ /session/ /voucher/ all 404), online-now,
# average dwell, and date filtering (start_date/end_date and from/to are silently
# ignored — identical total_count returned). Revenue is pursued via Stripe
# instead; see STRIPE_SECRET_KEY below.

# ── UniFi Site Manager cloud API (NETWORK epic, T11 — the PULL path) ─────────
# Preferred UniFi integration as of 2026-07-27: /api/cron/unifi-poll polls
# https://api.ui.com every 2 min (X-API-KEY header) and feeds device state into
# the same ingest pipeline the webhooks use. Chosen over webhooks because the
# vendor's payload shape and HMAC scheme are unconfirmed, and no vendor payload
# can say which RISE8 property a console belongs to — that mapping lives in
# lib/network/unifi-hosts.ts (explicit opt-in per console).
# Unset = no API call at all, poll reports `configured: false` and degrades.
UNIFI_API_KEY=""
# MULTIPLE ACCOUNTS: the 19 consoles are split across more than one Ubiquiti
# account (the first key sees only 5 - finding N1). Add a key per account as
# UNIFI_API_KEY_2 ... UNIFI_API_KEY_9; every one is polled and the snapshots are
# merged, de-duplicated by console id. One dead key does not blind the others.
UNIFI_API_KEY_2=""

# ── Teams notifications via Microsoft Graph (NETWORK epic, Task 7) ───────────
# Azure AD app registration for posting ticket lifecycle notifications into a
# property's Teams channel (spec §5.3/§5.4). Requires Graph API permissions
# `ChannelMessage.Send` (post + reply) and `ChannelMessage.Read.All` (reply
# ingestion, deferred to a later task). Unset today — no Azure app reg
# provisioned yet, no team/channel IDs confirmed (Kate/Kyle to provide per
# CLAUDE.md open question #4). Until all three are set (AND the target
# property has Property.teamsChannelId populated), Teams posts degrade to a
# logged-only SKIPPED NotificationLog row — see lib/network/teams-config.ts
# + lib/network/teams-graph.server.ts.
MS_GRAPH_TENANT_ID=""
MS_GRAPH_CLIENT_ID=""
MS_GRAPH_CLIENT_SECRET=""

# ── Teams notifications via a Power Automate "Workflows" webhook ─────────────
# Send-only alternative to Graph, live since 2026-07-27. When set, ticket
# lifecycle events queue a PENDING TEAMS NotificationLog row and the 1-min cron
# delivers it (lib/network/teams-deliver.server.ts).
#
# ⚠ THIS URL IS A CREDENTIAL — its `sig=` query parameter is the only auth.
# Anyone holding it can post to the channel. Never commit it; regenerate the
# flow's URL if it leaks.
#
# Limits vs Graph (DevSpec §5.3/§5.4): send-only, so no threading (resolutions
# post as their own message, not a reply), no message id returned (Ticket
# .teamsMessageId stays empty), and T8 reply-ingestion is impossible. The
# endpoint returns 202 for anything it accepts, so "accepted" is the strongest
# claim we can make — it is not proof the channel post happened.
TEAMS_WEBHOOK_URL=""

# ── Error tracking (Sentry) ───────────────────────────────────────────────────
SENTRY_DSN=""

# ── Public app URL (exposed to the client) ────────────────────────────────────
# Same value as AUTH_URL but accessible in browser bundles.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Stripe (guest WiFi revenue — the figure Spotipo's API does not expose) ────
# Spotipo takes guest WiFi payments through Stripe, and Stripe's API DOES support
# date ranges — so it can answer both "revenue" and "revenue for a date range",
# neither of which Spotipo can.
#
# USE A RESTRICTED KEY (rk_live_...), NOT a full secret key (sk_live_...).
# Stripe > Developers > API keys > Create restricted key, with READ-ONLY on:
#   - Balance transactions  (net revenue after fees; date-filterable)
#   - Charges (or PaymentIntents)
# Everything else: None. A leaked restricted key can read past payments and
# nothing more - it cannot charge, refund, or move money.
#
# A PUBLISHABLE key (pk_...) cannot do this at all: it is designed to be public
# and can only tokenize cards client-side. It cannot list charges.
STRIPE_SECRET_KEY=
