// RISE8 Operations Platform — Prisma schema
// Phase 1 (Wed): users, properties, user_properties (ARCHITECTURE §4.1).
// Phase 2 (Week 2): rooms, checklist_templates, questions, recurring_rules,
// checklist_instances, responses, photos, issues, audit_log, notification_log.
// Contractor + quick-task tables (ADR-012) are intentionally deferred to
// Phase 9/10 — not modeled here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  HK
  PA
  MT
  MANAGER
  CORPORATE
  ADMIN
  // NETWORK section (IT staff). Dedicated IT/MSP role; NOT field staff and not a
  // full ADMIN. RBAC in lib/rbac.ts (canAccessNetwork). Display grouping in
  // lib/role-display.ts folds it into "Admin" for labels only.
  NETWORK_TECH
}

enum Locale {
  en
  es
}

enum RoomStatus {
  OCCUPIED
  VACANT
  OOO // out of order
}

enum TemplateScope {
  PER_ROOM
  PER_PROPERTY
  AD_HOC
}

enum ReviewLevel {
  NONE
  MANAGER
  CORPORATE
}

// All 11 question types (PRD). SECTION_DIVIDER is presentational only.
enum QuestionType {
  SINGLE
  MULTI
  YESNO
  PASSFAIL
  NUMBER
  SHORT_TEXT
  LONG_TEXT
  PHOTO
  SIGNATURE
  DATE
  SECTION_DIVIDER
}

enum InstanceStatus {
  SCHEDULED
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  REVIEWED
  FLAGGED
  INVALIDATED
  EXPIRED
}

// S1 (StayCheck v1.1): manager's manual Pass/Fail completion check at review.
enum CompletionCheck {
  PASS
  FAIL
}

enum GeofenceStatus {
  VERIFIED
  OFF_PROPERTY
  NO_GPS
  // GPS captured but the property has no polygon configured yet — re-evaluate
  // in Phase 6 once polygons are drawn (lib/geofence.ts).
  UNVERIFIED
}

enum IssueStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  WONT_FIX
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  TEAMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// Contractor-job lifecycle (T2). Deliberately shorter than the future unified
// Ticket lifecycle: no TRIAGED/BLOCKED, because a dispatcher creates these
// already-triaged and the MVP has no blocked state to act on.
enum JobStatus {
  OPEN // created, not yet dispatched
  DISPATCHED // contractor assigned + message sent (T4)
  IN_PROGRESS // contractor working
  COMPLETED
  CANCELLED // requires a completionNote reason
}

// Contractor trades (Component II — Contractor Dispatch, ADR-025). Plumbing +
// electrical are the most common emergencies (Kyle 2026-07-08); the rest cover
// the maintenance/dispatch brief's skill list.
enum Trade {
  PLUMBING
  ELECTRICAL
  HVAC
  APPLIANCE
  GENERAL
  COSMETIC
  LANDSCAPING
  PEST_CONTROL
  ROOFING
}

// ---------------------------------------------------------------------------
// NETWORK section enums (network monitoring + IT ticketing).
// DevSpec_NetworkMonitoringTicketing_RISE8_072426. Ported onto the platform
// stack; see docs/superpowers/plans/2026-07-25-network-monitoring-ticketing.md.
// ---------------------------------------------------------------------------

enum DeviceType {
  CAMERA
  AP // access point
  // Added by T11 (UniFi poller, 2026-07-27). The live KW fleet is mostly
  // switches plus one gateway console, so CAMERA|AP alone would have forced
  // every switch to be labelled "AP" in the UI. Additive enum values only.
  SWITCH
  GATEWAY // UDM / UCG / UCK console
  NVR // UniFi Protect recorder
}

enum DeviceSource {
  UNIFI_PROTECT // cameras
  UNIFI_NETWORK // UniFi APs
  ARUBA // Aruba Instant On APs
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

enum NetworkEventType {
  PROBLEM
  RECOVERY
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketType {
  STANDARD
  MASS_OUTAGE
}

enum TicketNoteSource {
  TEAMS_REPLY
  MANUAL
}

// ---------------------------------------------------------------------------
// Core identity (Phase 1)
// ---------------------------------------------------------------------------

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique
  passwordHash        String    @map("password_hash")
  name                String
  role                Role
  locale              Locale    @default(en)
  active              Boolean   @default(true)
  mfaEnabled          Boolean   @default(false) @map("mfa_enabled")
  mfaSecret           String?   @map("mfa_secret")
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz
  // Account lockout (ADR-008): 5 failed attempts within 15 min -> 30 min lock.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lastFailedLoginAt   DateTime? @map("last_failed_login_at") @db.Timestamptz
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz
  phone               String?
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  properties        UserProperty[]
  assignedInstances ChecklistInstance[] @relation("InstanceAssignee")
  reviewedInstances ChecklistInstance[] @relation("InstanceReviewer")
  verifiedInstances ChecklistInstance[] @relation("InstanceVerifier")
  assignedIssues    Issue[]             @relation("IssueAssignee")
  auditLogs         AuditLog[]
  notifications     NotificationLog[]
  createdRules      RecurringRule[]     @relation("RuleCreatedBy")
  loginOtps         LoginOtp[]
  // A staff member can ALSO be a contractor (e.g. Jesús Pérez is both a
  // scheduler and an electrical contractor). One optional link — not mutually
  // exclusive with their staff role (Component II, ADR-025).
  contractor        Contractor?         @relation("UserContractor")
  createdContractorJobs ContractorJob[]  @relation("ContractorJobCreatedBy")

  @@map("users")
}

model Property {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @unique @map("property_id")
  name       String
  shortCode  String   @unique @map("short_code") @db.VarChar(2)
  address    String
  geofence   Json?
  active     Boolean  @default(true)
  // NETWORK section: Microsoft Teams channel for this property's ticket posts
  // (Graph API, ADR pending) + Spotipo guest-WiFi site. apiKey handling (env vs
  // encrypted column) settled at the Spotipo task; nullable until configured.
  teamsChannelId   String? @map("teams_channel_id")
  teamsChannelName String? @map("teams_channel_name")
  spotipoSiteId    String? @map("spotipo_site_id")
  spotipoApiKey    String? @map("spotipo_api_key")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users              UserProperty[]
  rooms              Room[]
  recurringRules     RecurringRule[]
  instances          ChecklistInstance[]
  issues             Issue[]
  templateProperties TemplateProperty[]
  devices            Device[]
  networkEvents      NetworkEvent[]
  tickets            Ticket[]
  contractors        ContractorProperty[]
  contractorJobs     ContractorJob[]

  @@map("properties")
}

model UserProperty {
  userId     String @map("user_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([userId, propertyId])
  @@index([propertyId])
  @@map("user_properties")
}

model LoginOtp {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_otps")
}

// ---------------------------------------------------------------------------
// Properties → rooms (manual occupancy; no PMS integration in v1, ADR-009)
// ---------------------------------------------------------------------------

model Room {
  id         String     @id @default(uuid()) @db.Uuid
  propertyId String     @map("property_id") @db.Uuid
  roomNumber String     @map("room_number")
  status     RoomStatus @default(VACANT)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  property  Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  instances ChecklistInstance[]
  issues    Issue[]

  @@unique([propertyId, roomNumber])
  @@index([propertyId])
  @@map("rooms")
}

// ---------------------------------------------------------------------------
// Templates + questions
// ---------------------------------------------------------------------------

model ChecklistTemplate {
  id            String        @id @default(uuid()) @db.Uuid
  // ADR-009 templateCode used in the CL-{prop}-{code}-{date}-{seq} system ID.
  code                  String        @unique @db.VarChar(8)
  name                  String
  version               Int           @default(1)
  defaultRole           Role          @map("default_role")
  scope                 TemplateScope
  reviewLevel           ReviewLevel   @default(MANAGER) @map("review_level")
  active                Boolean       @default(true)
  allProperties         Boolean       @default(false) @map("all_properties")
  // S1: gates the checkout-flag capture block (fill flow + review confirm).
  // On for Departure/checkout-type templates, off elsewhere.
  collectsCheckoutFlags Boolean       @default(false) @map("collects_checkout_flags")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  questions      Question[]
  recurringRules RecurringRule[]
  instances      ChecklistInstance[]
  properties     TemplateProperty[]

  @@map("checklist_templates")
}

model Question {
  id             String       @id @default(uuid()) @db.Uuid
  templateId     String       @map("template_id") @db.Uuid
  orderIndex     Int          @map("order_index")
  type           QuestionType
  prompt         String
  required       Boolean      @default(true)
  options        Json? // for SINGLE / MULTI
  photoMin       Int?         @map("photo_min")
  photoMax       Int?         @map("photo_max")
  failFlagsIssue Boolean      @default(false) @map("fail_flags_issue") // PASSFAIL
  conditional    Json? // { show_if: { question_id, value } }
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  template      ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  responses     Response[]
  sourcedIssues Issue[]           @relation("IssueSourceQuestion")

  @@index([templateId])
  @@map("questions")
}

model TemplateProperty {
  id         String @id @default(uuid()) @db.Uuid
  templateId String @map("template_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  property Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([templateId, propertyId])
  @@index([propertyId])
  @@map("template_properties")
}

// ---------------------------------------------------------------------------
// Recurring rules (ADR-009) — generation logic lands Phase 5
// ---------------------------------------------------------------------------

model RecurringRule {
  id              String    @id @default(uuid()) @db.Uuid
  templateId      String    @map("template_id") @db.Uuid
  propertyId      String    @map("property_id") @db.Uuid
  pattern         Json // { type: 'daily'|'weekly'|'monthly'|'quarterly'|'on-demand', ... }
  assignment      Json // { type: 'user'|'role'|'unassigned', target: ... }
  // ADR-009 per-room scope filter for PER_ROOM templates:
  // { kind: 'all'|'occupied'|'vacant'|'list'|'range', roomNumbers?, from?, to? }.
  // Null = 'all' for PER_ROOM; ignored for PER_PROPERTY / AD_HOC.
  scope           Json?
  // ADR-009 effective window (inclusive ET dates) + skip-day list (yyyyMMdd[]).
  effectiveFrom   DateTime? @map("effective_from") @db.Date
  effectiveTo     DateTime? @map("effective_to") @db.Date
  skipDays        Json?     @map("skip_days")
  // Creator for audit context (manager mutations also written to audit_log).
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  template  ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  property  Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdBy User?             @relation("RuleCreatedBy", fields: [createdByUserId], references: [id])

  @@index([templateId])
  @@index([propertyId])
  @@index([propertyId, active])
  @@map("recurring_rules")
}

// ---------------------------------------------------------------------------
// Checklist instances + responses + photos
// ---------------------------------------------------------------------------

model ChecklistInstance {
  id         String  @id @default(uuid()) @db.Uuid
  // ADR-009 human/system ID CL-{prop}-{code}-{YYYYMMDD}-{seq}; assigned at
  // generation, hence nullable until then.
  systemId   String? @unique @map("system_id")
  title      String?
  templateId String  @map("template_id") @db.Uuid
  propertyId String  @map("property_id") @db.Uuid
  roomId     String? @map("room_id") @db.Uuid

  scheduledFor   DateTime       @map("scheduled_for") @db.Date
  dueAt          DateTime?      @map("due_at") @db.Timestamptz
  assignedUserId String?        @map("assigned_user_id") @db.Uuid
  status         InstanceStatus @default(SCHEDULED)

  invalidationReason     String? @map("invalidation_reason")
  reassignedToInstanceId String? @unique @map("reassigned_to_instance_id") @db.Uuid

  openedAt         DateTime? @map("opened_at") @db.Timestamptz
  submittedAt      DateTime? @map("submitted_at") @db.Timestamptz
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz
  reviewedByUserId String?   @map("reviewed_by_user_id") @db.Uuid
  // Manager note from the review left rail (ADR-011); set on approve/flag/redo.
  managerNote      String?   @map("manager_note")

  // S1 (StayCheck v1.1) — review workflow upgrade
  // Manager's manual Pass/Fail completion check at review (Q1).
  completionCheck  CompletionCheck? @map("completion_check")
  // Verify-by-PM lock (Q4): once verified, the instance is immutable except an
  // admin-only unlock. lockedAt is the enforcement anchor (lib/review-lock.ts).
  verifiedByPm     Boolean   @default(false) @map("verified_by_pm")
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz
  verifiedByUserId String?   @map("verified_by_user_id") @db.Uuid
  lockedAt         DateTime? @map("locked_at") @db.Timestamptz
  // Structured checkout flags (Q2/Q3): captured by staff at fill when the
  // template collectsCheckoutFlags, confirmed/editable by manager at review.
  notifyCorporate  Boolean   @default(false) @map("notify_corporate")
  returnDeposit    Boolean   @default(false) @map("return_deposit")
  itemsToReplace   Boolean   @default(false) @map("items_to_replace")
  itemsToReplaceList String? @map("items_to_replace_list")
  // placeOOO stored now; room-lifecycle wiring is S2 (typed hook only here).
  placeOOO         Boolean   @default(false) @map("place_ooo")
  // Free-text room fallback (PRD §17/§24: "-", "Suite") when no Room row.
  roomLabel        String?   @map("room_label")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  template     ChecklistTemplate @relation(fields: [templateId], references: [id])
  property     Property          @relation(fields: [propertyId], references: [id])
  room         Room?             @relation(fields: [roomId], references: [id])
  assignedUser User?             @relation("InstanceAssignee", fields: [assignedUserId], references: [id])
  reviewedBy   User?             @relation("InstanceReviewer", fields: [reviewedByUserId], references: [id])
  verifiedBy   User?             @relation("InstanceVerifier", fields: [verifiedByUserId], references: [id])

  // Self-relation: an invalidated instance points to its replacement.
  reassignedToInstance ChecklistInstance?  @relation("InstanceReassignment", fields: [reassignedToInstanceId], references: [id])
  reassignedFrom       ChecklistInstance[] @relation("InstanceReassignment")

  responses     Response[]
  sourcedIssues Issue[]    @relation("IssueSourceInstance")

  @@index([propertyId, scheduledFor])
  @@index([assignedUserId, status])
  @@index([status, dueAt])
  @@index([templateId])
  @@index([roomId])
  @@index([reviewedByUserId])
  @@index([verifiedByUserId])
  @@map("checklist_instances")
}

model Response {
  id          String   @id @default(uuid()) @db.Uuid
  instanceId  String   @map("instance_id") @db.Uuid
  questionId  String   @map("question_id") @db.Uuid
  answer      Json // shape depends on question type
  notes       String?
  respondedAt DateTime @default(now()) @map("responded_at") @db.Timestamptz

  instance ChecklistInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  question Question          @relation(fields: [questionId], references: [id])
  photos   Photo[]

  @@index([instanceId])
  @@index([questionId])
  @@map("responses")
}

model Photo {
  id             String         @id @default(uuid()) @db.Uuid
  // A photo hangs off EXACTLY ONE owner: a checklist Response (capture-at-fill)
  // OR an Issue (resolution evidence) OR a ContractorJob (T2 problem photos).
  // All three FKs are nullable; the app enforces exactly-one-set (submit action
  // / closeIssue / createContractorJob). No DB CHECK — Prisma can't express it;
  // every write path is server-only and validated.
  responseId      String?       @map("response_id") @db.Uuid
  issueId         String?       @map("issue_id") @db.Uuid
  contractorJobId String?       @map("contractor_job_id") @db.Uuid
  r2Key          String         @map("r2_key")
  fileSizeBytes  Int            @map("file_size_bytes")
  exifTimestamp  DateTime?      @map("exif_timestamp") @db.Timestamptz
  capturedAt     DateTime?      @map("captured_at") @db.Timestamptz
  gpsLat         Decimal?       @map("gps_lat") @db.Decimal(9, 6)
  gpsLng         Decimal?       @map("gps_lng") @db.Decimal(9, 6)
  geofenceStatus GeofenceStatus @map("geofence_status")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz

  response      Response?      @relation(fields: [responseId], references: [id], onDelete: Cascade)
  issue         Issue?         @relation(fields: [issueId], references: [id], onDelete: Cascade)
  contractorJob ContractorJob? @relation(fields: [contractorJobId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([issueId])
  @@index([contractorJobId])
  // §4.2 wants a PARTIAL index on non-VERIFIED rows; Prisma can't express a
  // WHERE on @@index, so this is a plain index for now. Convert to partial via
  // a dedicated raw-SQL migration if/when the anomaly query needs it (table is
  // empty in v1, so deferred).
  @@index([geofenceStatus])
  @@map("photos")
}

// ---------------------------------------------------------------------------
// Issues pipeline
// ---------------------------------------------------------------------------

model Issue {
  id               String        @id @default(uuid()) @db.Uuid
  propertyId       String        @map("property_id") @db.Uuid
  roomId           String?       @map("room_id") @db.Uuid
  sourceInstanceId String?       @map("source_instance_id") @db.Uuid
  sourceQuestionId String?       @map("source_question_id") @db.Uuid
  title            String
  description      String?
  status           IssueStatus   @default(OPEN)
  priority         IssuePriority @default(MEDIUM)
  assignedUserId   String?       @map("assigned_user_id") @db.Uuid
  slaTargetAt      DateTime?     @map("sla_target_at") @db.Timestamptz
  resolvedAt       DateTime?     @map("resolved_at") @db.Timestamptz
  resolutionNote   String?       @map("resolution_note")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  property       Property           @relation(fields: [propertyId], references: [id])
  room           Room?              @relation(fields: [roomId], references: [id])
  sourceInstance ChecklistInstance? @relation("IssueSourceInstance", fields: [sourceInstanceId], references: [id])
  sourceQuestion Question?          @relation("IssueSourceQuestion", fields: [sourceQuestionId], references: [id])
  assignedUser   User?              @relation("IssueAssignee", fields: [assignedUserId], references: [id])
  photos         Photo[]

  @@index([propertyId, status])
  @@index([assignedUserId, status])
  @@index([slaTargetAt])
  @@index([sourceInstanceId])
  @@index([sourceQuestionId])
  @@index([roomId])
  @@map("issues")
}

// SLA defaults per issue priority (Phase 4). Admin-editable placeholders until
// Christopher confirms real values (ADR-014 follow-up); issue.slaTargetAt =
// issue.createdAt + hours at creation time. Editing a default does NOT
// retroactively move existing issues' targets.
model SlaDefault {
  priority  IssuePriority @id
  hours     Int
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@map("sla_defaults")
}

// ---------------------------------------------------------------------------
// NETWORK section + Contractor directory. Merged 2026-07-28: the NETWORK
// models came from main, the Contractor models from the Component II branch;
// they are independent and both are kept.
// NETWORK section — device monitoring + IT ticketing (kept fully separate from
// the Issue/maintenance pipeline). DevSpec §3–6. Property is REUSED (no second
// properties table); spec `rise8_id` = Property.propertyId.
// ---------------------------------------------------------------------------

// A monitored device (camera or AP). Uniquely keyed by name+property so repeat
// webhooks upsert the same row (DevSpec §4.2).
model Device {
  id            String       @id @default(uuid()) @db.Uuid
  deviceKey     String       @unique @map("device_key") // `${name}_${propertyId}`
  name          String
  type          DeviceType
  source        DeviceSource
  propertyId    String       @map("property_id") @db.Uuid
  lastSeenAt    DateTime?    @map("last_seen_at") @db.Timestamptz
  currentStatus DeviceStatus @default(UNKNOWN) @map("current_status")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  property Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  events   NetworkEvent[]
  tickets  Ticket[]

  @@index([propertyId])
  @@index([currentStatus])
  @@map("devices")
}

// A problem/recovery event mapped from a webhook (DevSpec §4.3). Renamed from
// the spec's `events` to avoid colliding with the audit/notification concept.
model NetworkEvent {
  id          String           @id @default(uuid()) @db.Uuid
  deviceId    String           @map("device_id") @db.Uuid
  propertyId  String           @map("property_id") @db.Uuid
  eventType   NetworkEventType @map("event_type")
  source      DeviceSource
  alertMessage String?         @map("alert_message")
  occurredAt  DateTime         @map("occurred_at") @db.Timestamptz
  receivedAt  DateTime         @default(now()) @map("received_at") @db.Timestamptz
  ticketId    String?          @map("ticket_id") @db.Uuid
  // Self-relation: the RECOVERY event that resolved this PROBLEM event.
  resolvedByEventId String?    @unique @map("resolved_by_event_id") @db.Uuid

  device          Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  property        Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ticket          Ticket?        @relation(fields: [ticketId], references: [id])
  resolvedByEvent NetworkEvent?  @relation("EventResolution", fields: [resolvedByEventId], references: [id])
  resolves        NetworkEvent[] @relation("EventResolution")

  @@index([deviceId, occurredAt])
  @@index([propertyId, occurredAt])
  @@index([ticketId])
  @@map("network_events")
}

// Raw inbound webhook payloads, stored separately for debugging + confirming
// firmware field names before parsers are trusted (DevSpec §3.3, §9).
model RawWebhookPayload {
  id             String       @id @default(uuid()) @db.Uuid
  source         DeviceSource
  signatureValid Boolean      @map("signature_valid")
  payload        Json
  receivedAt     DateTime     @default(now()) @map("received_at") @db.Timestamptz

  @@index([source, receivedAt])
  @@map("raw_webhook_payloads")
}

// An IT ticket (DevSpec §4.4 + §5.5 mass-outage additions).
model Ticket {
  id            String       @id @default(uuid()) @db.Uuid
  ticketNumber  String       @unique @map("ticket_number") // TKT-YYYYMMDD-NNN (ET daily seq)
  deviceId      String?      @map("device_id") @db.Uuid
  propertyId    String       @map("property_id") @db.Uuid
  triggerEventId String?     @map("trigger_event_id") @db.Uuid
  alertMessage  String?      @map("alert_message")
  status        TicketStatus @default(OPEN)
  ticketType    TicketType   @default(STANDARD) @map("ticket_type")
  openedAt      DateTime     @default(now()) @map("opened_at") @db.Timestamptz
  // Free-text for now (may be in-house IT or an external MSP name); can become
  // a User FK later if assignment moves fully in-house (DevSpec §4.4).
  assignedTo    String?      @map("assigned_to")
  resolutionNotes String?    @map("resolution_notes")
  resolvedAt    DateTime?    @map("resolved_at") @db.Timestamptz
  downDurationMin Int?       @map("down_duration_min")
  teamsNotified Boolean      @default(false) @map("teams_notified")
  teamsMessageId String?     @map("teams_message_id")
  teamsMessageUrl String?    @map("teams_message_url")
  // Mass-outage device-status snapshot (DevSpec §5.5).
  affectedDevices Json?      @map("affected_devices")
  parentTicketId String?     @map("parent_ticket_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  device       Device?        @relation(fields: [deviceId], references: [id])
  property     Property       @relation(fields: [propertyId], references: [id])
  parentTicket Ticket?        @relation("TicketChildren", fields: [parentTicketId], references: [id])
  childTickets Ticket[]       @relation("TicketChildren")
  events       NetworkEvent[]
  notes        TicketNote[]

  @@index([propertyId, status])
  @@index([status, openedAt])
  @@index([deviceId, status])
  @@index([parentTicketId])
  @@map("tickets")
}

// A note on a ticket — a Teams reply ingested via Graph, or a manual note
// (DevSpec §4.5). teamsReplyId dedupes on re-poll/re-delivery.
model TicketNote {
  id          String           @id @default(uuid()) @db.Uuid
  ticketId    String           @map("ticket_id") @db.Uuid
  source      TicketNoteSource
  author      String?
  teamsReplyId String?         @unique @map("teams_reply_id")
  content     String
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_notes")
}

// Durable timer substitute for BullMQ/Redis (decision 2026-07-25): a 1-minute
// Vercel Cron polls PENDING rows whose runAt has passed. Kinds (code values,
// reconciled Task 5 — supersedes this comment's earlier TICKET_5MIN /
// MASS_OUTAGE_10MIN placeholders): "STANDARD_TIMER" (5-min standard-ticket
// threshold, DevSpec §5.2) / "MASS_OUTAGE_CHECK" (10-min mass-outage
// resolution check, DevSpec §5.5).
model NetworkJob {
  id        String   @id @default(uuid()) @db.Uuid
  kind      String
  runAt     DateTime @map("run_at") @db.Timestamptz
  eventId   String?  @map("event_id") @db.Uuid
  ticketId  String?  @map("ticket_id") @db.Uuid
  status    String   @default("PENDING") // PENDING | DONE | CANCELLED
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([status, runAt])
  @@map("network_jobs")
}

// ---------------------------------------------------------------------------
// Contractor directory (Component II — Contractor Dispatch MVP, ADR-025)
// Layer 0 of the dispatch design: a directory of trades + coverage + channel so
// Gerardo/Jesus can surface the right contractor per property+trade, contracted-
// first. No contractor accounts — dispatch is via WhatsApp/phone (T4). A lean
// contractor-job record + WhatsApp dispatch build on top of this (T2/T4); it all
// migrates into the unified Ticket model in Phase II.1.
// ---------------------------------------------------------------------------

model Contractor {
  id         String  @id @default(uuid()) @db.Uuid
  name       String
  company    String?
  trades     Trade[]
  // Contractors use WhatsApp ONLY (Kyle 2026-07-08); phone is the emergency
  // first-touch for contracted contractors. No SMS — they don't use it.
  whatsapp   String?
  phone      String?
  // Contractors report in Spanish; back-office reads English (dispatch brief §4.2).
  language   Locale  @default(es)
  // `contracted` = direct hire / under contract → called first in an emergency
  // (currently only Orlando Torres). `onCall` = currently available for urgent
  // dispatch. `active` = soft-delete / still in the directory.
  contracted Boolean @default(false)
  onCall     Boolean @default(true)
  active     Boolean @default(true)
  notes      String?
  // Optional link to a staff User who is ALSO a contractor (Jesús Pérez). Unique
  // — one User maps to at most one Contractor row. SetNull so deleting the staff
  // account leaves the contractor directory entry intact.
  userId     String? @unique @map("user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user       User?                @relation("UserContractor", fields: [userId], references: [id], onDelete: SetNull)
  properties ContractorProperty[]
  jobs       ContractorJob[]

  @@index([active])
  @@map("contractors")
}

// Which properties a contractor covers (many-to-many; mirrors user_properties).
model ContractorProperty {
  contractorId String @map("contractor_id") @db.Uuid
  propertyId   String @map("property_id") @db.Uuid

  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([contractorId, propertyId])
  @@index([propertyId])
  @@map("contractor_properties")
}

// A dispatchable contractor job (T2 — Contractor Dispatch MVP). Deliberately a
// STRICT SUBSET of the future unified Ticket (Phase II.1): every column here
// exists there too, so folding this table into Ticket is additive (rename +
// add kind/source/lifecycle columns) rather than a data reshape.
//
// Not modeled on purpose (YAGNI until the unified model is specced): SLA,
// scheduling/calendar (T6), cost capture, assignment history, and the two-way
// Accept/Decline/ETA states that belong to the WhatsApp Business API layer.
model ContractorJob {
  id     String @id @default(uuid()) @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  // Free text, not a Room FK: rooms are only seeded for Lakeland (no PMS in
  // v1), jobs are portfolio-wide, and a dispatch message just needs "Rm 212" /
  // "lobby" / "roof". Matches S1's free-text-room direction.
  roomLabel  String? @map("room_label")
  trade      Trade
  problem    String
  // Boolean, not a priority enum: the emergency-classification rule is still
  // pending from Gerardo, so this is a manual dispatcher toggle. Sorts the job
  // to the top of the queue and is what the later emergency-alert task fires on.
  urgent     Boolean   @default(false)
  status     JobStatus @default(OPEN)
  // Set at dispatch (T3 match -> T4 send). Null while the job is unassigned.
  contractorId    String? @map("contractor_id") @db.Uuid
  createdByUserId String  @map("created_by_user_id") @db.Uuid
  // Required when moving to COMPLETED or CANCELLED (enforced in the action).
  completionNote  String? @map("completion_note")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  property   Property    @relation(fields: [propertyId], references: [id])
  contractor Contractor? @relation(fields: [contractorId], references: [id])
  createdBy  User        @relation("ContractorJobCreatedBy", fields: [createdByUserId], references: [id])
  photos     Photo[]

  @@index([propertyId, status])
  @@index([contractorId])
  @@index([urgent, status])
  @@map("contractor_jobs")
}

// ---------------------------------------------------------------------------
// Audit log + notification log (both "keep forever" per ADR-013)
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  action      String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_log")
}

model NotificationLog {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String?             @map("user_id") @db.Uuid // null for channel-only (e.g. Teams)
  channel    NotificationChannel
  status     NotificationStatus  @default(PENDING)
  // Free-text event key, e.g. 'submission', 'flag', 'teams_digest'.
  event      String
  title      String
  body       String?
  // For Teams per-channel logging (ADR-010): which channel/webhook target.
  target     String?
  // Related entity for deep-linking from the in-app notification center.
  entityType String?             @map("entity_type")
  entityId   String?             @map("entity_id") @db.Uuid
  readAt     DateTime?           @map("read_at") @db.Timestamptz // in-app read state
  error      String? // failure detail when status = FAILED
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([channel, status])
  @@index([entityType, entityId])
  @@map("notification_log")
}
