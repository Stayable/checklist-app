// RISE8 Operations Platform — Prisma schema
// Phase 1 (Wed): users, properties, user_properties (ARCHITECTURE §4.1).
// Phase 2 (Week 2): rooms, checklist_templates, questions, recurring_rules,
// checklist_instances, responses, photos, issues, audit_log, notification_log.
// Quick-task tables (ADR-012) are intentionally deferred — not modeled here.
// Contractor / dispatch tables were dropped 2026-08-03 (ADR-028): Track D moved
// out of this codebase. Contractor SCHEDULING returned 2026-08-11 (ADR-030) as
// a new, narrower feature — see the contractor models near the end of this
// file. Everything that SENDS to a contractor is still gone and stays gone.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  HK
  PA
  MT
  MANAGER
  CORPORATE
  ADMIN
  // NETWORK section (IT staff). Dedicated IT/MSP role; NOT field staff and not a
  // full ADMIN. RBAC in lib/rbac.ts (canAccessNetwork). Display grouping in
  // lib/role-display.ts folds it into "Admin" for labels only.
  NETWORK_TECH
  // Checklist-only management role (added 2026-08-12 for RPM/GSA testing).
  // Sees and does everything a MANAGER can inside the Checklist section, and
  // is deliberately EXCLUDED from Maintenance, Construction, Network and
  // Admin — see canAccessMaintenance in lib/roles.ts. The exclusion is a real
  // authorization check, not just a hidden nav entry: /maintenance/* is
  // guarded by requireMaintenanceAccess(), so a URL or a server action refuses
  // an AGENT too.
  AGENT
}

enum Locale {
  en
  es
}

enum RoomStatus {
  OCCUPIED
  VACANT
  OOO // out of order
}

enum TemplateScope {
  PER_ROOM
  PER_PROPERTY
  AD_HOC
}

enum ReviewLevel {
  NONE
  MANAGER
  CORPORATE
}

// All 11 question types (PRD). SECTION_DIVIDER is presentational only.
enum QuestionType {
  SINGLE
  MULTI
  YESNO
  PASSFAIL
  NUMBER
  SHORT_TEXT
  LONG_TEXT
  PHOTO
  SIGNATURE
  DATE
  SECTION_DIVIDER
}

enum InstanceStatus {
  SCHEDULED
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  REVIEWED
  FLAGGED
  INVALIDATED
  EXPIRED
}

/**
 * Why an assignment stopped being needed or doable.
 * Split by WHO the fact is about, which is what decides whether approval is
 * required (Kyle, 2026-08-21, amending ADR-014):
 * - facts about the ROOM (stayover, not needed, duplicate) close immediately,
 * because the work ceased to exist and a stayover happens daily across
 * 1,172 rooms — an approval queue for it would be noise, not control;
 * - facts about the PERSON (unavailable, no access) need a manager, which is
 * what ADR-014's approval step was actually aimed at: a field user should
 * not be able to silently drop work that still needs doing.
 * OTHER requires approval on purpose — an unclassified reason is exactly the
 * case a human should read.
 */
enum InvalidationReason {
  STAYOVER
  ROOM_NOT_NEEDED
  DUPLICATE
  STAFF_UNAVAILABLE
  NO_ACCESS
  OTHER
}

// S1 (StayCheck v1.1): manager's manual Pass/Fail completion check at review.
enum CompletionCheck {
  PASS
  FAIL
}

enum GeofenceStatus {
  VERIFIED
  OFF_PROPERTY
  NO_GPS
  // GPS captured but the property has no polygon configured yet — re-evaluate
  // in Phase 6 once polygons are drawn (lib/geofence.ts).
  UNVERIFIED
}

enum IssueStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  WONT_FIX
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  TEAMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// ---------------------------------------------------------------------------
// NETWORK section enums (network monitoring + IT ticketing).
// DevSpec_NetworkMonitoringTicketing_RISE8_072426. Ported onto the platform
// stack; see docs/superpowers/plans/2026-07-25-network-monitoring-ticketing.md.
// ---------------------------------------------------------------------------

enum DeviceType {
  CAMERA
  AP // access point
  // Added by T11 (UniFi poller, 2026-07-27). The live KW fleet is mostly
  // switches plus one gateway console, so CAMERA|AP alone would have forced
  // every switch to be labelled "AP" in the UI. Additive enum values only.
  SWITCH
  GATEWAY // UDM / UCG / UCK console
  NVR // UniFi Protect recorder
}

enum DeviceSource {
  UNIFI_PROTECT // cameras
  UNIFI_NETWORK // UniFi APs
  ARUBA // Aruba Instant On APs
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

enum NetworkEventType {
  PROBLEM
  RECOVERY
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketType {
  STANDARD
  MASS_OUTAGE
}

enum TicketNoteSource {
  TEAMS_REPLY
  MANUAL
}

// ---------------------------------------------------------------------------
// Contractor scheduling enums (2026-08-11 design, ADR-030).
//
// `Contractor`, `Trade` and `JobStatus` were dropped from schema AND from the
// production database on 2026-08-03 by 20260803120000_drop_contractor_dispatch
// (Track D dispatch rail, commit 94ce338). What follows is NOT a revival of
// that rail: it is a new, narrower scheduling feature that happens to reuse
// two of the old names because they are the correct domain nouns and are now
// free. There is no dispatch, no messaging, and no contractor-facing link —
// see the models below and docs/superpowers/specs/2026-08-11-contractor-
// scheduling-design.md.
// ---------------------------------------------------------------------------

enum Trade {
  PLUMBING
  ELECTRICAL
  HVAC
  ROOFING
  PEST
  LANDSCAPING
  PRESSURE_WASHING
  GENERAL
}

// Named in full (not the dropped `JobStatus`) because its values describe a
// planning lifecycle, not a dispatch one. Deliberately NO `DISPATCHED` value:
// nothing in this feature dispatches or messages a contractor.
enum ContractorJobStatus {
  PLANNED
  // Added 2026-08-13 for the contractor update fan-out
  // (docs/ContractorUpdateFanout_Contract_081226.md §8). The WhatsApp pipeline
  // emits "Delayed" for ALL off-plan work — a crew that spent the day on
  // something other than the scheduled task — which is the single most useful
  // thing it produces. Without this value it collapsed onto PLANNED and
  // rendered identically to a task nobody had touched.
  //
  // NOT TERMINAL: a delayed job can still be worked, rescheduled and
  // completed, so it belongs in OPEN_JOB_STATUSES and stays overdue-able.
  DELAYED
  IN_PROGRESS
  DONE
  CANCELLED
}

// How a fan-out update was resolved (docs/…Contract_081226.md §7). Stored so
// the outcome is queryable rather than inferred from which rows exist — in
// particular DAILY_NOTE (nothing matched) must be visible, because its
// user-facing symptom is an unchanged calendar, which looks exactly like
// success.
enum ContractorUpdateResolution {
  JOB_STATUS // matched a job; status changed + note appended
  JOB_NOTE // matched a job; note only (no status change, or job terminal)
  DAILY_NOTE // no job matched, or outcome=flagged -> ContractorDailyNote
  AMBIGUOUS // >1 candidate job; nothing written to a job (see §Q41)
}

// Who wrote a note: a staff/admin user, or automation posting on their
// behalf (`SYSTEM`, e.g. an auto-appended status-change note, or a crew update
// arriving from Kyle's separate contractor-update project). This value was
// written as the seam for that ingest; the receiver now uses it
// (app/api/webhooks/contractor-update).
enum ContractorNoteSource {
  STAFF
  SYSTEM
}

// ---------------------------------------------------------------------------
// Core identity (Phase 1)
// ---------------------------------------------------------------------------

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique
  passwordHash        String    @map("password_hash")
  name                String
  role                Role
  locale              Locale    @default(en)
  active              Boolean   @default(true)
  // Forces a password change before the account can use anything else. Set for
  // admin-provisioned accounts whose first password was handed over
  // out-of-band, so a shared or spoken temp password cannot stay in use.
  // Enforced in requireUser() (lib/rbac.ts), i.e. server-side on every guarded
  // page and action — not merely prompted in the UI.
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  mfaEnabled          Boolean   @default(false) @map("mfa_enabled")
  mfaSecret           String?   @map("mfa_secret")
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz
  // Account lockout (ADR-008): 5 failed attempts within 15 min -> 30 min lock.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lastFailedLoginAt   DateTime? @map("last_failed_login_at") @db.Timestamptz
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz
  phone               String?
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  properties            UserProperty[]
  assignedInstances     ChecklistInstance[]   @relation("InstanceAssignee")
  reviewedInstances     ChecklistInstance[]   @relation("InstanceReviewer")
  verifiedInstances     ChecklistInstance[]   @relation("InstanceVerifier")
  invalidationRequests  ChecklistInstance[]   @relation("InstanceInvalidationRequester")
  assignedIssues        Issue[]               @relation("IssueAssignee")
  auditLogs             AuditLog[]
  notifications         NotificationLog[]
  createdRules          RecurringRule[]       @relation("RuleCreatedBy")
  loginOtps             LoginOtp[]
  contractorJobsCreated ContractorJob[]       @relation("ContractorJobCreatedBy")
  contractorJobNotes    ContractorJobNote[]   @relation("ContractorJobNoteAuthor")
  contractorDailyNotes  ContractorDailyNote[] @relation("ContractorDailyNoteAuthor")

  @@map("users")
}

model Property {
  id               String   @id @default(uuid()) @db.Uuid
  propertyId       String   @unique @map("property_id")
  name             String
  shortCode        String   @unique @map("short_code") @db.VarChar(2)
  address          String
  geofence         Json?
  active           Boolean  @default(true)
  // NETWORK section: Microsoft Teams channel for this property's ticket posts
  // (Graph API, ADR pending) + Spotipo guest-WiFi site. apiKey handling (env vs
  // encrypted column) settled at the Spotipo task; nullable until configured.
  teamsChannelId   String?  @map("teams_channel_id")
  teamsChannelName String?  @map("teams_channel_name")
  spotipoSiteId    String?  @map("spotipo_site_id")
  spotipoApiKey    String?  @map("spotipo_api_key")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users                UserProperty[]
  rooms                Room[]
  recurringRules       RecurringRule[]
  instances            ChecklistInstance[]
  issues               Issue[]
  templateProperties   TemplateProperty[]
  devices              Device[]
  networkEvents        NetworkEvent[]
  tickets              Ticket[]
  contractors          ContractorProperty[]
  contractorJobs       ContractorJob[]
  contractorDailyNotes ContractorDailyNote[]

  @@map("properties")
}

model UserProperty {
  userId     String @map("user_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([userId, propertyId])
  @@index([propertyId])
  @@map("user_properties")
}

model LoginOtp {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_otps")
}

// ---------------------------------------------------------------------------
// Properties → rooms (manual occupancy; no PMS integration in v1, ADR-009)
// ---------------------------------------------------------------------------

model Room {
  id         String     @id @default(uuid()) @db.Uuid
  propertyId String     @map("property_id") @db.Uuid
  roomNumber String     @map("room_number")
  // Zone (building) and room type, from the Cloudbeds inventory export loaded
  // 2026-08-12. Nullable because a hand-added room may not know either. Zone is
  // operationally load-bearing, not decoration: it is how work is split at a
  // 150-room property ("Building A today"), and how a room picker stays usable.
  // JW, DP and KW zoning was marked PROVISIONAL at the source.
  zone       String?    @map("zone")
  roomType   String?    @map("room_type")
  // ⚠ NOT real occupancy. The inventory export deliberately excludes occupancy
  // and out-of-order state ("they change daily and would be stale the moment
  // this file is written"), so every imported room takes this default. Until a
  // PMS sync or manual upkeep exists, a recurring rule that filters on
  // occupied/vacant is filtering on a default, not on fact.
  status     RoomStatus @default(VACANT)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  property  Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  instances ChecklistInstance[]
  issues    Issue[]

  @@unique([propertyId, roomNumber])
  @@index([propertyId])
  @@map("rooms")
}

// ---------------------------------------------------------------------------
// Templates + questions
// ---------------------------------------------------------------------------

model ChecklistTemplate {
  id                    String        @id @default(uuid()) @db.Uuid
  // ADR-009 templateCode used in the CL-{prop}-{code}-{date}-{seq} system ID.
  code                  String        @unique @db.VarChar(8)
  name                  String
  version               Int           @default(1)
  defaultRole           Role          @map("default_role")
  scope                 TemplateScope
  reviewLevel           ReviewLevel   @default(MANAGER) @map("review_level")
  active                Boolean       @default(true)
  allProperties         Boolean       @default(false) @map("all_properties")
  // S1: gates the checkout-flag capture block (fill flow + review confirm).
  // On for Departure/checkout-type templates, off elsewhere.
  collectsCheckoutFlags Boolean       @default(false) @map("collects_checkout_flags")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  questions      Question[]
  recurringRules RecurringRule[]
  instances      ChecklistInstance[]
  properties     TemplateProperty[]

  @@map("checklist_templates")
}

model Question {
  id             String       @id @default(uuid()) @db.Uuid
  templateId     String       @map("template_id") @db.Uuid
  orderIndex     Int          @map("order_index")
  type           QuestionType
  prompt         String
  required       Boolean      @default(true)
  options        Json? // for SINGLE / MULTI
  photoMin       Int?         @map("photo_min")
  photoMax       Int?         @map("photo_max")
  failFlagsIssue Boolean      @default(false) @map("fail_flags_issue") // PASSFAIL
  conditional    Json? // { show_if: { question_id, value } }
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  template      ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  responses     Response[]
  sourcedIssues Issue[]           @relation("IssueSourceQuestion")

  @@index([templateId])
  @@map("questions")
}

model TemplateProperty {
  id         String @id @default(uuid()) @db.Uuid
  templateId String @map("template_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  property Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([templateId, propertyId])
  @@index([propertyId])
  @@map("template_properties")
}

// ---------------------------------------------------------------------------
// Recurring rules (ADR-009) — generation logic lands Phase 5
// ---------------------------------------------------------------------------

model RecurringRule {
  id              String    @id @default(uuid()) @db.Uuid
  templateId      String    @map("template_id") @db.Uuid
  propertyId      String    @map("property_id") @db.Uuid
  pattern         Json // { type: 'daily'|'weekly'|'monthly'|'quarterly'|'on-demand', ... }
  assignment      Json // { type: 'user'|'role'|'unassigned', target: ... }
  // ADR-009 per-room scope filter for PER_ROOM templates:
  // { kind: 'all'|'occupied'|'vacant'|'list'|'range', roomNumbers?, from?, to? }.
  // Null = 'all' for PER_ROOM; ignored for PER_PROPERTY / AD_HOC.
  scope           Json?
  // ADR-009 effective window (inclusive ET dates) + skip-day list (yyyyMMdd[]).
  effectiveFrom   DateTime? @map("effective_from") @db.Date
  effectiveTo     DateTime? @map("effective_to") @db.Date
  skipDays        Json?     @map("skip_days")
  // Creator for audit context (manager mutations also written to audit_log).
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  template  ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  property  Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdBy User?             @relation("RuleCreatedBy", fields: [createdByUserId], references: [id])

  @@index([templateId])
  @@index([propertyId])
  @@index([propertyId, active])
  @@map("recurring_rules")
}

// ---------------------------------------------------------------------------
// Checklist instances + responses + photos
// ---------------------------------------------------------------------------

model ChecklistInstance {
  id         String  @id @default(uuid()) @db.Uuid
  // ADR-009 human/system ID CL-{prop}-{code}-{YYYYMMDD}-{seq}; assigned at
  // generation, hence nullable until then.
  systemId   String? @unique @map("system_id")
  title      String?
  templateId String  @map("template_id") @db.Uuid
  propertyId String  @map("property_id") @db.Uuid
  roomId     String? @map("room_id") @db.Uuid

  scheduledFor   DateTime       @map("scheduled_for") @db.Date
  dueAt          DateTime?      @map("due_at") @db.Timestamptz
  assignedUserId String?        @map("assigned_user_id") @db.Uuid
  status         InstanceStatus @default(SCHEDULED)

  // Free-text note from whoever closed or requested closing this instance.
  invalidationReason            String?             @map("invalidation_reason")
  // Structured reason, so a stayover can be counted rather than buried in prose.
  invalidationReasonCode        InvalidationReason? @map("invalidation_reason_code")
  // Set when someone asks for closure that needs approval. NOT a new
  // InstanceStatus value on purpose: `status: { in: [...] }` filters silently
  // EXCLUDE a new enum member and `notIn` silently INCLUDE it, so adding one
  // would quietly redefine /review's tabs, the reports denominators, the
  // dashboard's in-flight tiles and the field home list, all with a clean
  // typecheck. A pending request is still assigned work; only the surfaces that
  // care about the request need to know about it.
  invalidationRequestedAt       DateTime?           @map("invalidation_requested_at") @db.Timestamptz
  invalidationRequestedByUserId String?             @map("invalidation_requested_by_user_id") @db.Uuid
  reassignedToInstanceId        String?             @unique @map("reassigned_to_instance_id") @db.Uuid

  openedAt         DateTime? @map("opened_at") @db.Timestamptz
  submittedAt      DateTime? @map("submitted_at") @db.Timestamptz
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz
  reviewedByUserId String?   @map("reviewed_by_user_id") @db.Uuid
  // Manager note from the review left rail (ADR-011); set on approve/flag/redo.
  managerNote      String?   @map("manager_note")

  // S1 (StayCheck v1.1) — review workflow upgrade
  // Manager's manual Pass/Fail completion check at review (Q1).
  completionCheck    CompletionCheck? @map("completion_check")
  // Verify-by-PM lock (Q4): once verified, the instance is immutable except an
  // admin-only unlock. lockedAt is the enforcement anchor (lib/review-lock.ts).
  verifiedByPm       Boolean          @default(false) @map("verified_by_pm")
  verifiedAt         DateTime?        @map("verified_at") @db.Timestamptz
  verifiedByUserId   String?          @map("verified_by_user_id") @db.Uuid
  lockedAt           DateTime?        @map("locked_at") @db.Timestamptz
  // Structured checkout flags (Q2/Q3): captured by staff at fill when the
  // template collectsCheckoutFlags, confirmed/editable by manager at review.
  notifyCorporate    Boolean          @default(false) @map("notify_corporate")
  returnDeposit      Boolean          @default(false) @map("return_deposit")
  itemsToReplace     Boolean          @default(false) @map("items_to_replace")
  itemsToReplaceList String?          @map("items_to_replace_list")
  // placeOOO stored now; room-lifecycle wiring is S2 (typed hook only here).
  placeOOO           Boolean          @default(false) @map("place_ooo")
  // Free-text room fallback (PRD §17/§24: "-", "Suite") when no Room row.
  roomLabel          String?          @map("room_label")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  template                ChecklistTemplate @relation(fields: [templateId], references: [id])
  property                Property          @relation(fields: [propertyId], references: [id])
  room                    Room?             @relation(fields: [roomId], references: [id])
  assignedUser            User?             @relation("InstanceAssignee", fields: [assignedUserId], references: [id])
  reviewedBy              User?             @relation("InstanceReviewer", fields: [reviewedByUserId], references: [id])
  verifiedBy              User?             @relation("InstanceVerifier", fields: [verifiedByUserId], references: [id])
  invalidationRequestedBy User?             @relation("InstanceInvalidationRequester", fields: [invalidationRequestedByUserId], references: [id])

  // Self-relation: an invalidated instance points to its replacement.
  reassignedToInstance ChecklistInstance?  @relation("InstanceReassignment", fields: [reassignedToInstanceId], references: [id])
  reassignedFrom       ChecklistInstance[] @relation("InstanceReassignment")

  responses     Response[]
  sourcedIssues Issue[]    @relation("IssueSourceInstance")

  @@index([propertyId, scheduledFor])
  @@index([assignedUserId, status])
  @@index([status, dueAt])
  @@index([templateId])
  @@index([roomId])
  @@index([reviewedByUserId])
  @@index([verifiedByUserId])
  @@index([invalidationRequestedAt])
  @@map("checklist_instances")
}

model Response {
  id          String   @id @default(uuid()) @db.Uuid
  instanceId  String   @map("instance_id") @db.Uuid
  questionId  String   @map("question_id") @db.Uuid
  answer      Json // shape depends on question type
  notes       String?
  respondedAt DateTime @default(now()) @map("responded_at") @db.Timestamptz

  instance ChecklistInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  question Question          @relation(fields: [questionId], references: [id])
  photos   Photo[]

  @@index([instanceId])
  @@index([questionId])
  @@map("responses")
}

model Photo {
  id             String         @id @default(uuid()) @db.Uuid
  // A photo hangs off EXACTLY ONE owner: a checklist Response (capture-at-fill)
  // OR an Issue (resolution evidence). Both FKs are nullable; the app enforces
  // exactly-one-set (submit action / closeIssue). No DB CHECK — Prisma can't
  // express it; every write path is server-only and validated.
  //
  // A third owner (ContractorJob) existed until 2026-08-03 and was dropped with
  // Track D (ADR-028). If a future owner is added, keep the exactly-one rule.
  responseId     String?        @map("response_id") @db.Uuid
  issueId        String?        @map("issue_id") @db.Uuid
  r2Key          String         @map("r2_key")
  fileSizeBytes  Int            @map("file_size_bytes")
  exifTimestamp  DateTime?      @map("exif_timestamp") @db.Timestamptz
  capturedAt     DateTime?      @map("captured_at") @db.Timestamptz
  gpsLat         Decimal?       @map("gps_lat") @db.Decimal(9, 6)
  gpsLng         Decimal?       @map("gps_lng") @db.Decimal(9, 6)
  geofenceStatus GeofenceStatus @map("geofence_status")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz

  response Response? @relation(fields: [responseId], references: [id], onDelete: Cascade)
  issue    Issue?    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([issueId])
  // §4.2 wants a PARTIAL index on non-VERIFIED rows; Prisma can't express a
  // WHERE on @@index, so this is a plain index for now. Convert to partial via
  // a dedicated raw-SQL migration if/when the anomaly query needs it (table is
  // empty in v1, so deferred).
  @@index([geofenceStatus])
  @@map("photos")
}

// ---------------------------------------------------------------------------
// Issues pipeline
// ---------------------------------------------------------------------------

model Issue {
  id               String        @id @default(uuid()) @db.Uuid
  propertyId       String        @map("property_id") @db.Uuid
  roomId           String?       @map("room_id") @db.Uuid
  sourceInstanceId String?       @map("source_instance_id") @db.Uuid
  sourceQuestionId String?       @map("source_question_id") @db.Uuid
  title            String
  description      String?
  status           IssueStatus   @default(OPEN)
  priority         IssuePriority @default(MEDIUM)
  assignedUserId   String?       @map("assigned_user_id") @db.Uuid
  slaTargetAt      DateTime?     @map("sla_target_at") @db.Timestamptz
  resolvedAt       DateTime?     @map("resolved_at") @db.Timestamptz
  resolutionNote   String?       @map("resolution_note")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  property       Property           @relation(fields: [propertyId], references: [id])
  room           Room?              @relation(fields: [roomId], references: [id])
  sourceInstance ChecklistInstance? @relation("IssueSourceInstance", fields: [sourceInstanceId], references: [id])
  sourceQuestion Question?          @relation("IssueSourceQuestion", fields: [sourceQuestionId], references: [id])
  assignedUser   User?              @relation("IssueAssignee", fields: [assignedUserId], references: [id])
  photos         Photo[]

  @@index([propertyId, status])
  @@index([assignedUserId, status])
  @@index([slaTargetAt])
  @@index([sourceInstanceId])
  @@index([sourceQuestionId])
  @@index([roomId])
  @@map("issues")
}

// SLA defaults per issue priority (Phase 4). Admin-editable placeholders until
// Christopher confirms real values (ADR-014 follow-up); issue.slaTargetAt =
// issue.createdAt + hours at creation time. Editing a default does NOT
// retroactively move existing issues' targets.
model SlaDefault {
  priority  IssuePriority @id
  hours     Int
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@map("sla_defaults")
}

// ---------------------------------------------------------------------------
// NETWORK section — device monitoring + IT ticketing (kept fully separate from
// the Issue/maintenance pipeline). DevSpec §3–6. Property is REUSED (no second
// properties table); spec `rise8_id` = Property.propertyId.
// ---------------------------------------------------------------------------

// A monitored device (camera or AP). Uniquely keyed by name+property so repeat
// webhooks upsert the same row (DevSpec §4.2).
model Device {
  id            String       @id @default(uuid()) @db.Uuid
  deviceKey     String       @unique @map("device_key") // `${name}_${propertyId}`
  name          String
  type          DeviceType
  source        DeviceSource
  propertyId    String       @map("property_id") @db.Uuid
  /// Site Manager host id of the console this device is reported by. Nullable:
  /// webhook-sourced devices have no console, and rows predating 2026-07-31 are
  /// backfilled by the next poll rather than by a migration. Deliberately not an
  /// FK — the console registry is a code constant (lib/network/unifi-hosts.ts),
  /// not a table, and labels are resolved from it at render time.
  consoleHostId String?      @map("console_host_id")
  lastSeenAt    DateTime?    @map("last_seen_at") @db.Timestamptz
  currentStatus DeviceStatus @default(UNKNOWN) @map("current_status")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  property Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  events   NetworkEvent[]
  tickets  Ticket[]

  @@index([propertyId])
  @@index([currentStatus])
  @@map("devices")
}

// A problem/recovery event mapped from a webhook (DevSpec §4.3). Renamed from
// the spec's `events` to avoid colliding with the audit/notification concept.
model NetworkEvent {
  id                String           @id @default(uuid()) @db.Uuid
  deviceId          String           @map("device_id") @db.Uuid
  propertyId        String           @map("property_id") @db.Uuid
  eventType         NetworkEventType @map("event_type")
  source            DeviceSource
  alertMessage      String?          @map("alert_message")
  occurredAt        DateTime         @map("occurred_at") @db.Timestamptz
  receivedAt        DateTime         @default(now()) @map("received_at") @db.Timestamptz
  ticketId          String?          @map("ticket_id") @db.Uuid
  // Self-relation: the RECOVERY event that resolved this PROBLEM event.
  resolvedByEventId String?          @unique @map("resolved_by_event_id") @db.Uuid

  device          Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  property        Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ticket          Ticket?        @relation(fields: [ticketId], references: [id])
  resolvedByEvent NetworkEvent?  @relation("EventResolution", fields: [resolvedByEventId], references: [id])
  resolves        NetworkEvent[] @relation("EventResolution")

  @@index([deviceId, occurredAt])
  @@index([propertyId, occurredAt])
  @@index([ticketId])
  @@map("network_events")
}

// Raw inbound webhook payloads, stored separately for debugging + confirming
// firmware field names before parsers are trusted (DevSpec §3.3, §9).
model RawWebhookPayload {
  id             String       @id @default(uuid()) @db.Uuid
  source         DeviceSource
  signatureValid Boolean      @map("signature_valid")
  payload        Json
  receivedAt     DateTime     @default(now()) @map("received_at") @db.Timestamptz

  @@index([source, receivedAt])
  @@map("raw_webhook_payloads")
}

// An IT ticket (DevSpec §4.4 + §5.5 mass-outage additions).
model Ticket {
  id              String       @id @default(uuid()) @db.Uuid
  ticketNumber    String       @unique @map("ticket_number") // TKT-YYYYMMDD-NNN (ET daily seq)
  deviceId        String?      @map("device_id") @db.Uuid
  propertyId      String       @map("property_id") @db.Uuid
  triggerEventId  String?      @map("trigger_event_id") @db.Uuid
  alertMessage    String?      @map("alert_message")
  status          TicketStatus @default(OPEN)
  ticketType      TicketType   @default(STANDARD) @map("ticket_type")
  openedAt        DateTime     @default(now()) @map("opened_at") @db.Timestamptz
  // Free-text for now (may be in-house IT or an external MSP name); can become
  // a User FK later if assignment moves fully in-house (DevSpec §4.4).
  assignedTo      String?      @map("assigned_to")
  resolutionNotes String?      @map("resolution_notes")
  resolvedAt      DateTime?    @map("resolved_at") @db.Timestamptz
  downDurationMin Int?         @map("down_duration_min")
  // When this ticket crossed the escalation threshold and the escalation
  // notification was queued (Kyle 2026-08-01). Escalation used to be computed
  // on read for a badge only; notifying needs persistence, because "has this
  // already been announced?" cannot be derived from openedAt alone. Acts as the
  // idempotency key for the escalation sweep — set once, never cleared.
  escalatedAt     DateTime?    @map("escalated_at") @db.Timestamptz
  teamsNotified   Boolean      @default(false) @map("teams_notified")
  teamsMessageId  String?      @map("teams_message_id")
  teamsMessageUrl String?      @map("teams_message_url")
  // Mass-outage device-status snapshot (DevSpec §5.5).
  affectedDevices Json?        @map("affected_devices")
  parentTicketId  String?      @map("parent_ticket_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  device       Device?        @relation(fields: [deviceId], references: [id])
  property     Property       @relation(fields: [propertyId], references: [id])
  parentTicket Ticket?        @relation("TicketChildren", fields: [parentTicketId], references: [id])
  childTickets Ticket[]       @relation("TicketChildren")
  events       NetworkEvent[]
  notes        TicketNote[]

  @@index([propertyId, status])
  @@index([status, openedAt])
  @@index([deviceId, status])
  @@index([parentTicketId])
  // Drives the escalation sweep's only query: open tickets not yet escalated.
  @@index([status, escalatedAt])
  @@map("tickets")
}

// A note on a ticket — a Teams reply ingested via Graph, or a manual note
// (DevSpec §4.5). teamsReplyId dedupes on re-poll/re-delivery.
model TicketNote {
  id           String           @id @default(uuid()) @db.Uuid
  ticketId     String           @map("ticket_id") @db.Uuid
  source       TicketNoteSource
  author       String?
  teamsReplyId String?          @unique @map("teams_reply_id")
  content      String
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_notes")
}

// Durable timer substitute for BullMQ/Redis (decision 2026-07-25): a 1-minute
// Vercel Cron polls PENDING rows whose runAt has passed. Kinds (code values,
// reconciled Task 5 — supersedes this comment's earlier TICKET_5MIN /
// MASS_OUTAGE_10MIN placeholders): "STANDARD_TIMER" (5-min standard-ticket
// threshold, DevSpec §5.2) / "MASS_OUTAGE_CHECK" (10-min mass-outage
// resolution check, DevSpec §5.5).
model NetworkJob {
  id        String   @id @default(uuid()) @db.Uuid
  kind      String
  runAt     DateTime @map("run_at") @db.Timestamptz
  eventId   String?  @map("event_id") @db.Uuid
  ticketId  String?  @map("ticket_id") @db.Uuid
  status    String   @default("PENDING") // PENDING | DONE | CANCELLED
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([status, runAt])
  @@map("network_jobs")
}

// ---------------------------------------------------------------------------
// Audit log + notification log (both "keep forever" per ADR-013)
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  action      String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_log")
}

model NotificationLog {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String?             @map("user_id") @db.Uuid // null for channel-only (e.g. Teams)
  channel    NotificationChannel
  status     NotificationStatus  @default(PENDING)
  // Free-text event key, e.g. 'submission', 'flag', 'teams_digest'.
  event      String
  title      String
  body       String?
  // For Teams per-channel logging (ADR-010): which channel/webhook target.
  target     String?
  // Related entity for deep-linking from the in-app notification center.
  entityType String?             @map("entity_type")
  entityId   String?             @map("entity_id") @db.Uuid
  readAt     DateTime?           @map("read_at") @db.Timestamptz // in-app read state
  error      String? // failure detail when status = FAILED
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([channel, status])
  @@index([entityType, entityId])
  @@map("notification_log")
}

// ---------------------------------------------------------------------------
// Contractor scheduling (2026-08-11 design, ADR-030).
//
// New, narrower models for a scheduling-only feature — NOT a revert of the
// Track D dispatch rail dropped 2026-08-03 (94ce338,
// 20260803120000_drop_contractor_dispatch). That rail's dispatch-only fields
// (`contracted`, `onCall`, a `Contractor.userId` link to `User`, and a
// contractor-owned `Photo`) are deliberately absent here because nothing in
// this feature dispatches, messages, or issues a contractor-facing link. See
// docs/superpowers/specs/2026-08-11-contractor-scheduling-design.md.
// ---------------------------------------------------------------------------

model Contractor {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  company   String?
  trades    Trade[]
  phone     String?
  // Contact information only — no code path sends a message to this number.
  // Messaging/dispatch was removed with Track D and is out of scope here.
  whatsapp  String?
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  properties ContractorProperty[]
  jobs       ContractorJob[]

  @@map("contractors")
}

model ContractorProperty {
  contractorId String @map("contractor_id") @db.Uuid
  propertyId   String @map("property_id") @db.Uuid

  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([contractorId, propertyId])
  @@index([propertyId])
  @@map("contractor_properties")
}

model ContractorJob {
  id              String              @id @default(uuid()) @db.Uuid
  propertyId      String              @map("property_id") @db.Uuid
  // Free text, not a Room FK — rooms are only seeded for Lakeland (no PMS in
  // v1) and a schedule entry needs to say "Rm 212" / "lobby" / "roof".
  // Consistent with S1's free-text-room direction (lib/room-label.ts).
  roomLabel       String?             @map("room_label")
  trade           Trade
  description     String
  urgent          Boolean             @default(false)
  status          ContractorJobStatus @default(PLANNED)
  contractorId    String?             @map("contractor_id") @db.Uuid
  // Nullable, and that is load-bearing: null means "unscheduled backlog," a
  // real state the schedule UI surfaces (a persistent backlog rail), not
  // missing data. Date-only (ET calendar date) per the 2026-08-11 decision —
  // no times, no durations.
  scheduledFor    DateTime?           @map("scheduled_for") @db.Date
  createdByUserId String              @map("created_by_user_id") @db.Uuid
  // A real column so "completed today" is never inferred from `updatedAt` —
  // that would only hold while terminal rows stay immutable, a property no
  // schema enforces on its own.
  completedAt     DateTime?           @map("completed_at") @db.Timestamptz
  closeNote       String?             @map("close_note")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  property   Property            @relation(fields: [propertyId], references: [id])
  // SetNull is stated explicitly, and the asymmetry with property/createdBy
  // (both RESTRICT) is intended. Prisma already defaults an optional relation
  // to SetNull, so the behaviour is unchanged — writing it down stops a reader
  // concluding the FK actions were chosen inconsistently.
  //
  // The app never deletes a contractor (the directory archives instead, since
  // a delete would orphan job history), so this only governs an out-of-band
  // SQL delete. There, losing the assignment is the better failure than losing
  // the job: the same reasoning as ContractorJobNote.authorUserId, where a
  // note outlives its author's account.
  contractor Contractor?         @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  createdBy  User                @relation("ContractorJobCreatedBy", fields: [createdByUserId], references: [id])
  notes      ContractorJobNote[]
  updates    ContractorUpdate[]

  @@index([propertyId, scheduledFor])
  @@index([scheduledFor])
  @@index([contractorId])
  @@index([status])
  @@index([urgent, status])
  @@map("contractor_jobs")
}

// Append-only note on a ContractorJob. No `updatedAt`, no soft-delete column
// — "never overwritten" is a property of the schema shape, not app logic:
// there is simply no column an edit could be written into. Follows the
// existing TicketNote pattern.
model ContractorJobNote {
  id           String               @id @default(uuid()) @db.Uuid
  jobId        String               @map("job_id") @db.Uuid
  source       ContractorNoteSource
  // Nullable AND SetNull: a note must survive its author's account being
  // deleted. authorLabel is the durable attribution fallback once the author
  // is nulled, and carries the display name for SYSTEM rows.
  authorUserId String?              @map("author_user_id") @db.Uuid
  authorLabel  String?              @map("author_label")
  body         String
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz

  job        ContractorJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  authorUser User?         @relation("ContractorJobNoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@map("contractor_job_notes")
}

// Append-only written entry on the daily contractor dashboard (per-property
// or portfolio-wide when propertyId is null). Same append-only-by-shape rule
// as ContractorJobNote: no `updatedAt`, no soft-delete column. Deliberately
// NO unique constraint on (propertyId, forDate) — several entries for one
// day is correct behaviour for an append-only log, not a conflict.
model ContractorDailyNote {
  id           String               @id @default(uuid()) @db.Uuid
  propertyId   String?              @map("property_id") @db.Uuid
  forDate      DateTime             @map("for_date") @db.Date
  source       ContractorNoteSource
  authorUserId String?              @map("author_user_id") @db.Uuid
  authorLabel  String?              @map("author_label")
  body         String
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz

  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  authorUser User?     @relation("ContractorDailyNoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([forDate, propertyId])
  @@map("contractor_daily_notes")
}

// ---------------------------------------------------------------------------
// Contractor update fan-out (docs/ContractorUpdateFanout_Contract_081226.md).
//
// Inbound only: the WhatsApp voice pipeline posts a crew's update here after
// it writes Smartsheet. Nothing in this repo calls that pipeline, and adding
// these tables does not create a send path — see ADR-028/030.
//
// TWO tables on purpose, and the split is the whole point:
//
//   ContractorUpdateCapture — written unconditionally BEFORE parsing or
//     signature checking, including unparseable bodies. No unique constraint,
//     so a retried delivery is captured too. This is the forensic record; a
//     lost row here is a contractor's report of a day's work.
//
//   ContractorUpdate — the APPLIED record, `messageSid` unique, written in the
//     SAME transaction as the note and any status change it describes.
//
// Putting the unique key on the capture row instead would make the second
// delivery of a retried message throw on insert before any code could decide
// it was a duplicate — a 500 at exactly the moment Twilio is retrying, which
// produces more retries. With the split, the loser of a race hits the unique
// violation on the applied row, catches it, and returns the contract's
// 200 {ok:true, duplicate:true} (§5).
//
// Deliberately NOT reusing RawWebhookPayload: its `source` column is
// DeviceSource (UNIFI_PROTECT | UNIFI_NETWORK | ARUBA), a device enum also
// carried by Device. A contractor update is not a device source, and widening
// that enum would put a non-device value in front of every network device
// filter. The capture DISCIPLINE is copied; the table is not.
// ---------------------------------------------------------------------------

model ContractorUpdateCapture {
  id             String   @id @default(uuid()) @db.Uuid
  signatureValid Boolean  @map("signature_valid")
  payload        Json
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz

  @@index([receivedAt])
  @@map("contractor_update_captures")
}

model ContractorUpdate {
  id              String                     @id @default(uuid()) @db.Uuid
  // Twilio's message id. UNIQUE is the idempotency guarantee — the contract
  // (§5) requires a constraint rather than a findFirst check, because two
  // queue workers can overlap (visibilityTimeout 6 min vs functionTimeout 5).
  messageSid      String                     @unique @map("message_sid")
  contractVersion Int                        @map("contract_version")
  channel         String
  outcome         String
  // ET calendar date the work belongs to; half of the resolution key.
  workDate        DateTime                   @map("work_date") @db.Date
  contractorPhone String?                    @map("contractor_phone")
  contractorName  String                     @map("contractor_name")
  // Which key actually resolved the job: "phone" | "name" | null. Recorded
  // because production currently holds NO contractor phone numbers, so every
  // update falls to the name path the contract itself calls unsafe. Without
  // this column that fact is invisible — an unresolved update simply leaves
  // the calendar unchanged, which looks identical to success.
  matchedBy       String?                    @map("matched_by")
  resolution      ContractorUpdateResolution
  jobId           String?                    @map("job_id") @db.Uuid
  // The status this update caused, if any. Null for a note-only update.
  statusApplied   ContractorJobStatus?       @map("status_applied")
  // Audit reference ONLY. Never look a job up by it: the weekly rollover
  // clears every row and reissues ids, so this goes stale every Monday by
  // design (§7).
  smartsheetRowId String?                    @map("smartsheet_row_id")
  // The pipeline's own receive stamp, distinct from our createdAt — the gap
  // between them is queue latency.
  receivedAtUtc   DateTime                   @map("received_at_utc") @db.Timestamptz
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz

  // SetNull, matching ContractorJob.contractorId: the record that an update
  // arrived must outlive the job it landed on.
  job ContractorJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([workDate, contractorPhone])
  @@index([jobId])
  @@index([resolution, createdAt])
  @@map("contractor_updates")
}
